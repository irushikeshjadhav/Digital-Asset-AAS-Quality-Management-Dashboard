          },
          "value": [
            {
              "language": "en",
              "text": "Quality-relevant time series data from the Digital Factory machines (IMM, Laser Engraver, Delta Robot). Data is exchanged in JSON format. Live values are published over MQTT (Mosquitto broker); historical records are stored in TimescaleDB and exposed over a FastAPI REST API. Only quality-related measurements are exposed in this submodel — defect counts, good-part counts, cycle times and completion progress — filtered from each machine's full data stream. Each record holds one measurement: Time, MachineId, MetricName, Value, Unit."
            }
          ],
          "modelType": "MultiLanguageProperty"
        },
        {
          "idShort": "Record",
          "semanticId": {
            "type": "ExternalReference",
            "keys": [
